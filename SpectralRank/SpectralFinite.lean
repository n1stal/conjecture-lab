namespace SpectralRank.Indexed
abbrev Vec := Array Int
abbrev Bound := Nat × Nat × Array Vec
abbrev Cert := Vec × Array Bound
def edge (mask i j : Nat) : Bool :=
  if i == j then false else mask.testBit ((max i j)*(max i j-1)/2 + min i j)
def adj (mask i j : Nat) : Int := if edge mask i j then 1 else 0
def vec (z : Vec) (i : Nat) : Int := z[i]?.getD 0
def dotF (n : Nat) (u v : Fin n → Int) : Int :=
  (List.ofFn (fun i => u i * v i)).sum
def actF (n msk : Nat) (u : Fin n → Int) (i : Fin n) : Int :=
  dotF n (fun j => adj msk i j) u
def col (A : Array Vec) (i j : Nat) : Int := vec (A[i]?.getD #[]) j
def gramF (n msk q : Nat) (A : Array Vec) (i j : Nat) : Int :=
  let x (r : Fin n) := col A i r
  let y (r : Fin n) := col A j r
  100 * dotF n (actF n msk x) (actF n msk y) - (Int.ofNat q)^2 * dotF n x y
def every (n : Nat) (f : Fin n → Bool) : Bool := (List.ofFn f).all id
def someB (n : Nat) (f : Fin n → Bool) : Bool := (List.ofFn f).any id
def nonSing (n msk : Nat) (a : Array Bound) : Bool :=
  let q (i : Fin (n-3)) := (a[i.val]?.getD (0,0,#[])).1
  decide (200 < 3 * (List.ofFn (fun i => q i * q i)).sum) &&
  every (n-3) (fun i =>
    let (q,d,A) := a[i.val]?.getD (0,0,#[])
    if q == 0 then true else
      decide (i.val+4 ≤ d) &&
      every d (fun r => every d (fun s =>
        let g := gramF n msk q A r s
        if r == s then decide (0 < g) else g == 0)))
def sing (n msk : Nat) (z : Vec) : Bool :=
  someB n (fun i => vec z i != 0) &&
  every n (fun i => actF n msk (fun j => vec z j) i == 0)
def good (n msk : Nat) (x : Cert) : Bool := sing n msk x.1 || nonSing n msk x.2
