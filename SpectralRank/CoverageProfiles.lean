theorem all_step {α : Type} {p : α → Bool} {x : α} {xs : List α}
    (hx : p x = true) (hs : xs.all p = true) : (x :: xs).all p = true :=
  Bool.and_eq_true_iff.mpr ⟨hx,hs⟩

theorem rows_of_profile (n : Nat) (R S : Array Nat) (pairs : List (Nat × Array (Nat × Nat)))
    (hc : pairs.all (fun x => checkRow n x.1 S x.2) = true)
    (hr : R.toList = pairs.map Prod.fst) :
    ∀ r : Fin R.size, ∃ row, checkRow n R[r] S row = true := by
  intro r
  have hm : R[r] ∈ R.toList := by
    have hi : r.val < R.toList.length := by simp
    have h := List.getElem_mem hi
    rwa [Array.getElem_toList] at h
  rw [hr] at hm
  obtain ⟨w,hw,he⟩ := List.mem_map.mp hm
  refine ⟨w.2,?_⟩
  rw [← he]
  exact List.all_eq_true.mp hc w hw
