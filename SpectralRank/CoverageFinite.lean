def edge (mask i j : Nat) : Bool :=
  if i == j then false else mask.testBit ((max i j)*(max i j-1)/2 + min i j)
def extension (n mask b i j : Nat) : Bool :=
  if i == j then false else if i < n && j < n then edge mask i j else b.testBit (min i j)
def permutation (p i : Nat) : Nat := (p >>> (3*i)) &&& 7
def checkWitness (n mask b : Nat) (R : Array Nat) (v : Nat × Nat) : Bool :=
  let (r,p) := v
  (r < R.size) &&
  (List.range (n+1)).all (fun i => permutation p i ≤ n) &&
  (List.range (n+1)).all (fun j =>
    (List.range j).all fun i => permutation p i != permutation p j &&
      extension n mask b i j == edge R[r]! (permutation p i) (permutation p j))
def checkRow (n mask : Nat) (R : Array Nat) (row : Array (Nat × Nat)) : Bool :=
  (row.size == 2^n) &&
  (List.range (2^n)).all fun b => checkWitness n mask b R row[b]!
